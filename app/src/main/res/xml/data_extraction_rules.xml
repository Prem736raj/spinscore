<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Back up ordinary app preferences only. -->
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Device-to-device transfer follows the same privacy boundary. -->
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
